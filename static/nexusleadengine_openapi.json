    "/v1/leads/trigger-scan": {
      "post": {
        "tags": [
          "Lead Engine"
        ],
        "summary": "Trigger Scan",
        "description": "Full Autonomous Pipeline with Metered Credit Deduction:\n1. Authenticates client and validates credit balance.\n2. Discovers prospects in target high-ticket sector.\n3. Runs technical audit & AI scoring.\n4. Deducts 1 credit per qualified lead delivered.\n5. Dispatches M2M payloads to subscribed bots.",
        "operationId": "trigger_scan_v1_leads_trigger_scan_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EnrichedLead"
                  },
                  "title": "Response Trigger Scan V1 Leads Trigger Scan Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
