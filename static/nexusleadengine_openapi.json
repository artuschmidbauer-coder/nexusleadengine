  "components": {
    "schemas": {
      "AgentBuyRequest": {
        "properties": {
          "package_id": {
            "type": "string",
            "title": "Package Id",
            "default": "pack_micro_25"
          },
          "pay_currency": {
            "type": "string",
            "title": "Pay Currency",
            "default": "usdttrc20"
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "api_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          }
        },
        "type": "object",
        "title": "AgentBuyRequest"
      },
      "BotActionPayload": {
        "properties": {
          "recommended_channel": {
            "$ref": "#/components/schemas/ChannelType"
          },
          "estimated_ticket_value_usd": {
            "type": "integer",
            "title": "Estimated Ticket Value Usd",
            "description": "Estimated deal size for this client"
          },
          "pain_points": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pain Points"
          },
          "loss_hypothesis": {
            "type": "string",
            "title": "Loss Hypothesis",
            "description": "Estimated revenue lost by client due to missing automations"
          },
          "pre_drafted_outreach_hook": {
            "type": "string",
            "title": "Pre Drafted Outreach Hook",
            "description": "Personalized icebreaker text ready for bot sending"
          },
          "service_pitch_angle": {
            "type": "string",
            "title": "Service Pitch Angle",
            "description": "The exact solution angle to present"
          }
        },
        "type": "object",
        "required": [
          "recommended_channel",
          "estimated_ticket_value_usd",
          "pain_points",
          "loss_hypothesis",
          "pre_drafted_outreach_hook",
          "service_pitch_angle"
        ],
        "title": "BotActionPayload",
        "description": "The machine payload: exact intelligence for the client's automated bot"
      },
      "BuyRequest": {
        "properties": {
          "package_id": {
            "type": "string",
            "title": "Package Id"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "api_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          },
          "payment_method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Method",
            "default": "crypto"
          }
        },
        "type": "object",
        "required": [
          "package_id",
          "email"
        ],
        "title": "BuyRequest"
      },
      "ChannelType": {
        "type": "string",
        "enum": [
          "WHATSAPP",
          "COLD_EMAIL",
          "PHONE",
          "API_AUTO_BOOK"
        ],
        "title": "ChannelType"
      },
      "CreditBalanceResponse": {
        "properties": {
          "client_id": {
            "type": "string",
            "title": "Client Id"
          },
          "api_key_masked": {
            "type": "string",
            "title": "Api Key Masked"
          },
          "credits_balance": {
            "type": "integer",
            "title": "Credits Balance"
          },
          "total_consumed": {
            "type": "integer",
            "title": "Total Consumed"
          },
          "total_purchased": {
            "type": "integer",
            "title": "Total Purchased"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "client_id",
          "api_key_masked",
          "credits_balance",
          "total_consumed",
          "total_purchased",
          "status"
        ],
        "title": "CreditBalanceResponse"
      },
      "CreditPackage": {
        "properties": {
          "package_id": {
            "type": "string",
            "title": "Package Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "credits": {
            "type": "integer",
            "title": "Credits"
          },
          "price_usd": {
            "type": "number",
            "title": "Price Usd"
          },
          "unit_price_usd": {
            "type": "number",
            "title": "Unit Price Usd"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "package_id",
          "name",
          "credits",
          "price_usd",
          "unit_price_usd",
          "description"
        ],
        "title": "CreditPackage"
      },
      "EnrichedLead": {
        "properties": {
          "lead_id": {
            "type": "string",
            "title": "Lead Id"
          },
          "timestamp_utc": {
            "type": "integer",
            "title": "Timestamp Utc"
          },
          "score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "Overall Lead Quality Score"
          },
          "tier": {
            "$ref": "#/components/schemas/LeadScoreTier"
          },
          "business_name": {
            "type": "string",
            "title": "Business Name"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "location": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Location"
          },
          "contact_channels": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Contact Channels"
          },
          "tech_signals": {
            "$ref": "#/components/schemas/TechSignal"
          },
          "bot_action": {
            "$ref": "#/components/schemas/BotActionPayload"
          },
          "raw_metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Raw Metadata"
          }
        },
        "type": "object",
        "required": [
          "score",
